# Monitor Pro Go Control Plane Configuration
PORT=8080
REPLICA_ID=api-prod-01

# PostgreSQL 15+ Authoritative Storage
DB_HOST=localhost
DB_PORT=5432
DB_USER=monitopro
DB_PASSWORD=your_strong_postgres_password_here
DB_NAME=monitopro_db

# NATS JetStream 2.10+ Cluster URL
NATS_URL=nats://localhost:4222

# Cryptographic Authentication (Min 32 characters)
JWT_SECRET=production_strong_jwt_signing_key_32_characters_minimum

# Mail Dispatch (Alerts & Invitations)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587

# Endpoint Telemetry Ingestion Window (Seconds)
TELEMETRY_INTERVAL_SEC=30
